# --- Wan2.2-Remix NSFW 14B ---
# Exact filenames from https://huggingface.co/FX-FeiHou/wan2.2-Remix/tree/main?not-for-all-audiences=true
# Check the NSFW/ folder on the HF Files tab. Keep version + lighting the same for both.
# Verified low file on HF:
#   Wan2.2_Remix_NSFW_i2v_14b_low_lighting_fp8_e4m3fn_v3.0.safetensors
# High file verified as the filename used by Gusdev06's workflow
# (2026-11-20). Note: Gusdev06's Dockerfile downloads both files from
# the same Wan 2.1 URL, so do NOT copy its download URLs — only the names.
MODEL_HIGH_FILE=Wan2.2_Remix_NSFW_i2v_14b_high_lighting_fp8_e4m3fn_v3.0.safetensors
