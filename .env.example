# HF token — only if the repo is gated / private. Leave empty for public.
HF_TOKEN=

# RunPod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
DOCKER_IMAGE=<dockerhub-user>/wan22-remix-14b:latest
